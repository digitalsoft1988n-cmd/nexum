```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Environment variables
.env
.env.*

# Virtual Environment
venv/
env/
ENV/

# Static files
staticfiles/

# VS Code
.vscode/

# PyCharm
.idea/

# MacOS
.DS_Store

# Windows
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# Migrations cache
*.mo
*.pot

# Node modules (for future React frontend)
node_modules/

# Build folders
dist/
build/

# Package lock files
package-lock.json
yarn.lock

# Docker
docker-compose.override.yml

# Logs
logs/
*.log

# Temporary files
*.tmp
*.swp
```
